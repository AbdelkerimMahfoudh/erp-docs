# This repository holds the product documentation and the project rulebook.
#
# `backend/` and `mobile/` are their own git repositories with their own
# history (erp-backend, erp-mobile) and are deliberately excluded here — a
# nested repo would otherwise be committed as an opaque gitlink pointing at a
# commit this repository cannot resolve.
backend/
mobile/

# ── Local tooling & secrets ────────────────────────────────────────────────
.claude/
.env
.env.*

# ── Editor & OS artifacts ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
