# Values the compose stack itself needs — NAMES ONLY.
# Copy to `deploy/.env.staging`, which is git-ignored.

# The database name MUST contain "staging" or the reset guard refuses it.
STAGING_DB_NAME=phonestore_staging
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_ROOT_PASSWORD=

# The one published port. Put TLS in front of it.
STAGING_HTTP_PORT=8088

# Stamped into the image so /health/version can identify the deployment.
APP_COMMIT=
APP_BUILT_AT=
